# VibeGPT – Caddy Reverse Proxy Configuration
# Set DOMAIN to your real domain for automatic HTTPS. Automatic public
# certificates do NOT work for raw IP addresses.

{$DOMAIN:localhost} {
    # Compress responses (JS/CSS/HTML/JSON) — big win for the Next.js bundle.
    encode zstd gzip

    # Request body cap (uploads are 20 MB + multipart headroom).
    request_body {
        max_size 30MB
    }

    # API routes → FastAPI
    handle /api/* {
        reverse_proxy api:8000 {
            transport http {
                read_timeout 300s # LLM generation can take minutes
                write_timeout 300s
            }
        }
    }

    # Everything else → Next.js
    handle {
        reverse_proxy web:3000
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        # CSP in REPORT-ONLY first: violations are logged without breaking
        # the app. Once clean, promote to an enforcing Content-Security-Policy.
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        # Remove server identification.
        -Server
    }

    # Logging
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
