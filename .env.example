# ============================================================
# VibeGPT - Campus Study Agent
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=VibeGPT
DOMAIN=vibegpt.yourdomain.com
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Keep false for real FastAPI JWT authentication. Enable only for an offline UI demo.
NEXT_PUBLIC_DEMO_MODE=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vibegpt:vibegpt_dev_password@localhost:5432/vibegpt
POSTGRES_DB=vibegpt
POSTGRES_USER=vibegpt
POSTGRES_PASSWORD=vibegpt_dev_password
# Set true only while diagnosing database queries.
SQL_ECHO=false

# ── Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# ── AI / LLM ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GRAPHICS_SERVICE_URL=http://localhost:8010
GRAPHICS_REQUEST_TIMEOUT_SECONDS=45
OLLAMA_MODEL=llama3.2:3b
LLM_PROVIDER=ollama
# For a verified OpenAI-compatible gateway:
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
ROUTER_DEFAULT_MODEL=mimo-v2.5-free
# Only enable media types confirmed to work through your specific gateway.
ROUTER_MODEL_INPUT_MODALITIES=mimo-v2.5-free=image
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── File Storage ─────────────────────────────────────────────
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=20
STORAGE_BACKEND=local
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Backend-only secret. Never expose this key to the browser.
SUPABASE_SECRET_KEY=replace-with-a-new-sb_secret-key
# Optional legacy alternative:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Fill these after Oracle assigns the VPS public IP.
PUBLIC_API_URL=http://YOUR_VPS_PUBLIC_IP:8000
PUBLIC_WEB_URL=http://YOUR_VPS_PUBLIC_IP:3000

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Initial Admin (created on first startup) ─────────────────
INITIAL_ADMIN_EMAIL=admin@vibegpt.local
INITIAL_ADMIN_PASSWORD=change-this-admin-password

# ── Worker ───────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=10
WORKER_MAX_RETRIES=3
