{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "services/api",
      "entrypoint": "app/main.py",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "type": "service",
        "service": "api"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}