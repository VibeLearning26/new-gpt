{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://fixes-denied-attorneys-fda.trycloudflare.com/api/v1/:path*"
    },
    {
      "source": "/",
      "destination": {
        "type": "service",
        "service": "web"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
