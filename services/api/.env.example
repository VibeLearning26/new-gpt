# VibeGPT API — environment template. Copy to .env and adjust.
# .env is gitignored; never commit real keys.

# ── Application ──────────────────────────────────────────────
APP_ENV=development

# ── Database (matches infrastructure/docker-compose.yml) ─────
DATABASE_URL=postgresql+asyncpg://vibegpt:vibegpt_dev_password@localhost:5432/vibegpt
SQL_ECHO=false

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-string

# ── LLM provider: "ollama" (local) or "router" (9Router gateway) ──
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=300

# LLM gateway — OmniRoute (or 9Router), OpenAI-compatible.
# Dashboard: http://localhost:20128/dashboard — configure upstream provider
# keys (Xiaomi MiMo, OpenRouter, ...) inside the gateway dashboard itself.
# ROUTER_API_KEY only authenticates VibeGPT against your own gateway and is
# injected server-side — it never reaches the frontend.
# Inside Docker compose use ROUTER_BASE_URL=http://router:20128/v1.
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
ROUTER_DEFAULT_MODEL=opencode-zen/mimo-v2.5-free
ROUTER_DASHBOARD_URL=http://localhost:20128/dashboard
# Comma-separated allowlist of models students can pick (order = UI order).
# Leave empty to expose every model the gateway lists.
ROUTER_ALLOWED_MODELS=opencode-zen/big-pickle,opencode-zen/deepseek-v4-flash-free,opencode-zen/laguna-s-2.1-free,opencode-zen/ling-3.0-flash-free,opencode-zen/mimo-v2.5-free,opencode-zen/nemotron-3-ultra-free,opencode-zen/north-mini-code-free
ROUTER_MODEL_INPUT_MODALITIES=mimo-v2.5-free=image
